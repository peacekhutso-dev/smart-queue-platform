# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
# Generate each secret with:  openssl rand -hex 24
# (hex only — the DB init script embeds passwords in SQL, so no quotes.)

# ── Exposure (csposrgradserver1) ──
# Only the frontend nginx publishes a host port.
BIND_ADDR=0.0.0.0
FRONTEND_HOST_PORT=8090
# The URL people type into the browser (CORS, redirects, WebAuthn origin).
# Through an SSH tunnel (needed for camera/WebAuthn until there's HTTPS):
PUBLIC_ORIGIN=http://localhost:8090
# Direct campus access (no camera/WebAuthn over plain http):
# PUBLIC_ORIGIN=http://172.21.12.21:8090

# ── Databases ──
DB_PASS=
IDENTITY_DB_PASS=
BRANCH_DB_PASS=
QUEUE_DB_PASS=
DOCUMENT_DB_PASS=
FEEDBACK_DB_PASS=
CATALOG_DB_PASS=
PAYMENT_DB_PASS=

# ── Service secrets ──
GATEWAY_SHARED_SECRET=
JWT_EXPIRY=86400000
# true only once served over HTTPS.
JWT_COOKIE_SECURE=false
# Must be a hostname, never an IP. localhost works through an SSH tunnel.
WEBAUTHN_RP_ID=localhost
ANTHROPIC_API_KEY=

# ── Security gates (keep false outside local dev) ──
FACE_DEV_BYPASS=false
ZERO_TRUST_BYPASS=false
OTP_DEV_EXPOSE=true
